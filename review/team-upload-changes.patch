+      String(value.paymentStatus),
+    ) ||
+    !date(value.expiresAt) ||
+    !date(value.serverNow) ||
+    value.currency !== "PHP" ||
+    typeof value.canPay !== "boolean" ||
+    typeof value.canCancel !== "boolean" ||
