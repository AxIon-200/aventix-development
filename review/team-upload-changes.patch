+    )
+  )
+    return fail();
+  if (!Array.isArray(value.items) || !value.items.length) return fail();
+  const categories = new Set<string>();
+  const seats = new Set<string>();
+  for (const item of value.items) {
+    if (
+      !record(item) ||
+      !text(item.ticketCategoryId) ||
+      !text(item.name) ||
+      !count(item.quantity) ||
