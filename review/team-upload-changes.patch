+      String(value.event.status),
+    )
+  )
+    return fail();
+  if (
+    ![
+      "PENDING_PAYMENT",
+      "CONFIRMED",
+      "CANCELLED",
+      "EXPIRED",
+      "REFUNDED",
+    ].includes(String(value.status)) ||
