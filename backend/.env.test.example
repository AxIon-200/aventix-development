# Copy to .env.test and supply private values. Never use the development database.
NODE_ENV=test
DATABASE_URL=postgresql://USER:PASSWORD@TEST_HOST:5432/DATABASE
DEV_DATABASE_URL=postgresql://USER:PASSWORD@DEVELOPMENT_HOST:5432/DATABASE
TEST_DATABASE_PROJECT_REF=replace-with-your-dedicated-supabase-test-project-ref

FRONTEND_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=replace-with-a-private-random-secret-at-least-32-characters
