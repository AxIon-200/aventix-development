# Application
PORT=5000
NODE_ENV=development

# Frontend
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Authentication
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:5000

# Real-user registration and legacy acceptance stay unavailable until both owner-approved values exist.
# Use the exact version and URL of your reviewed terms document; no defaults.
CURRENT_TERMS_VERSION=
CURRENT_TERMS_DOCUMENT_URL=

# Resend transactional delivery. Keep credentials private; disable open/click tracking.
# A Resend test sender only supports the provider account owner's mailbox.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Direct-peer IP limits per 15-minute window (trust proxy is disabled).
AUTH_REGISTRATION_IP_LIMIT=5
AUTH_VERIFICATION_IP_LIMIT=10
AUTH_VERIFICATION_RESEND_IP_LIMIT=10
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGOUT_IP_LIMIT=60
AUTH_TERMS_ACCEPTANCE_IP_LIMIT=10
AUTH_RECOVERY_IP_LIMIT=10
AUTH_RESET_IP_LIMIT=10
AUTH_PASSWORD_CHANGE_IP_LIMIT=10
AUTH_AGGREGATE_IP_LIMIT=100

TEST_DATABASE_PROJECT_REF="azzbaqgeidgulvejglba"

organizer_functionalities

# Official PayMongo test webhooks. Server-side secrets only.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_WEBHOOK_PORT=5051

# Bank details: 32 random bytes encoded as 64 hex characters. Keep stable and server-only.
ORGANIZER_PAYOUT_KEY=
