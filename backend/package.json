{
  "name": "backend",
  "version": "1.0.0",
  "description": "This directory provides the starting architectural layout for the Aventix backend application, built with **NextJs**, **PostgreSQL**, and **Prisma ORM**.",
  "main": "index.js",
  "scripts": {
    "paymongo:webhook": "node --env-file=.env.test dist/commands/paymongo-webhook-server.js",
    "paymongo:register": "node --env-file=.env.test dist/commands/paymongo-register-webhook.js",
    "accounts": "tsx src/commands/accounts.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "node --env-file=.env.test --import tsx --watch src/server.ts",
    "seed:events": "npm run build && node --env-file=.env.test dist/commands/seed-events.js",
    "seed:seats": "npm run build && node --env-file=.env.test dist/commands/prepare-demo-seats.js",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
